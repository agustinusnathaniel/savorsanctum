{
  "name": "savorsanctum",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "type:check": "tsc",
    "test": "vp test run",
    "test:ui": "vp test --ui --coverage",
    "test:coverage": "vp test --coverage run",
    "biome:check": "biome check --no-errors-on-unmatched --error-on-warnings",
    "biome:fix": "pnpm biome:check --write",
    "biome:ci": "biome ci",
    "check:turbo": "turbo biome:check type:check test",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "prepare": "vp config",
    "validate:csp": "tsx scripts/validate-csp.ts",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@notionhq/client": "^5.27.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.48",
    "@tanstack/router-plugin": "1.168.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vite-plugin": "1.53.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "commit-and-tag-version": "^13.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.125.0"
  },
  "version": "1.3.0"
}
